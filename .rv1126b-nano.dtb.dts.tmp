 gic: interrupt-controller@21201000 {
  compatible = "arm,gic-400";
  #interrupt-cells = <3>;
  #address-cells = <0>;
  interrupt-controller;
  reg = <0x21201000 0x1000>,
        <0x21202000 0x2000>,
        <0x21204000 0x2000>,
        <0x21206000 0x2000>;
  interrupts = <1 9 ((((1 << (4)) - 1) << 8) | 8)>;
 };

