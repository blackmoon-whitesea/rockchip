# 44 "arch/arm64/boot/dts/rockchip/rv1126b-nano.dts" 2

/ {
 model = "Rockchip RV1126B NANO V10 Board";
 compatible = "rockchip,rv1126b-nano", "rockchip,rv1126b";

};

&pinctrl {

 pinctrl-names = "default";
 pinctrl-0 = <&mobile_rst &mobile_airplane &spk_ctl &sensor_pins>;

 mygpio_set {
  /omit-if-no-ref/
  uart2_485_pins: uart2-485-pins {
   rockchip,pins =

    <3 6 0 &pcfg_pull_none>;
  };
  /omit-if-no-ref/
  uart4_485_pins: uart4-485-pins {
   rockchip,pins =

    <5 26 0 &pcfg_pull_none>;
  };
  /omit-if-no-ref/
  uart6_485_pins: uart6-485-pins {
   rockchip,pins =

    <5 16 0 &pcfg_pull_none>;
  };
  /omit-if-no-ref/
  uart7_485_pins: uart7-485-pins {
   rockchip,pins =

    <5 17 0 &pcfg_pull_none>;
  };
  /omit-if-no-ref/
  sensor_pins:sensor-pins {
   rockchip,pins =

    <5 19 0 &pcfg_output_low>,

    <5 22 0 &pcfg_pull_down>,

    <5 21 0 &pcfg_pull_down>,

    <3 10 0 &pcfg_pull_down>,

    <3 11 0 &pcfg_pull_down>,

    <5 20 0 &pcfg_pull_down>,

    <7 8 0 &pcfg_pull_down>,

    <5 10 0 &pcfg_pull_down>;
  };
 };

 mobile {
  /omit-if-no-ref/
  mobile_rst: mobile-rst {
   rockchip,pins =
    <5 1 0 &pcfg_output_high>;
  };
  /omit-if-no-ref/
  mobile_airplane: mobile-airplane {
   rockchip,pins =
    <5 0 0 &pcfg_output_high>;
  };
 };
 sound-card {
  /omit-if-no-ref/
  spk_ctl: spk-ctl {
   rockchip,pins =
    <0 8 0 &pcfg_output_high>;
  };
 };
};
