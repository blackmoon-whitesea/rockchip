/ {
 chosen {
  bootargs = "earlycon=uart8250,mmio32,0x20810000 console=ttyFIQ0 rw root=PARTUUID=614e0000-0000 rootfstype=ext4 rootwait snd_soc_core.prealloc_buffer_size_kbytes=16 coherent_pool=32K net.ifnames=0";
 };


 pwm_gpio: pwm-gpio {
  #pwm-cells = <3>;
  compatible = "pwm-gpio";
  gpios = <&gpio0 4 0>;
 };


 vcc5v0_sys: vcc5v0-sys {
  compatible = "regulator-fixed";
  regulator-name = "vcc5v0_sys";
  regulator-always-on;
  regulator-boot-on;
  regulator-min-microvolt = <5000000>;
  regulator-max-microvolt = <5000000>;

  status = "okay";
 };

 vdd_npu: vdd-npu {
  compatible = "pwm-regulator";
  pwms = <&pwm_gpio 0 25000 1>;
  regulator-name = "vdd_npu";
  regulator-init-microvolt = <950000>;
  regulator-min-microvolt = <750000>;
  regulator-max-microvolt = <1100000>;
  regulator-always-on;
  regulator-boot-on;
  enable-gpios = <&gpio0 3 0>;
  pwm-supply = <&vcc5v0_sys>;
 };
};

&cpu0 {
 cpu-supply = <&vdd_cpu>;
};

&crypto {
 status = "okay";
};

&emmc {
 bus-width = <8>;
 cap-mmc-highspeed;
 non-removable;
