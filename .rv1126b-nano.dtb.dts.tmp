  regulator-name = "vccio_sd";
  regulator-min-microvolt = <1800000>;
  regulator-max-microvolt = <3300000>;
  pinctrl-names = "default";
  pinctrl-0 = <&sdmmc_volt>;
  gpios = <&gpio0 6 0>;
  vin-supply = <&vcc5v0_sys>;
  states = <1800000 0x0
     3300000 0x1>;
 };
};

&sdmmc0 {
 max-frequency = <200000000>;
 no-sdio;
 no-mmc;
 bus-width = <4>;
 cap-mmc-highspeed;
 cap-sd-highspeed;
 disable-wp;
 sd-uhs-sdr104;
