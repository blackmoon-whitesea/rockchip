/ {
 vcc_1v8_board: vcc-1v8-board {
  compatible = "regulator-fixed";
  regulator-name = "vcc_1v8_board";
  regulator-always-on;
  regulator-boot-on;
  regulator-min-microvolt = <1800000>;
  regulator-max-microvolt = <1800000>;
  vin-supply = <&vcc_5v_board>;
 };

 vcc_3v3_board: vcc-3v3-board {
  compatible = "regulator-fixed";
  regulator-name = "vcc_3v3_board";
  regulator-always-on;
  regulator-boot-on;
  regulator-min-microvolt = <3300000>;
  regulator-max-microvolt = <3300000>;
  vin-supply = <&vcc_5v_board>;
 };

 vcc_5v_board: vcc-5v-board {
  pinctrl-names = "default";
  pinctrl-0 = <&vcc_5v_en>;
  compatible = "regulator-fixed";
  regulator-name = "vcc_5v_board";
  gpio = <&gpio0 7 0>;
  enable-active-high;
  regulator-always-on;
  regulator-boot-on;
  regulator-min-microvolt = <5000000>;
  regulator-max-microvolt = <5000000>;
 };
};

