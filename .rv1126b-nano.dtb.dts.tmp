 };

 usb_host_ehci: usb@21480000 {
  compatible = "generic-ehci";
  reg = <0x21480000 0x40000>;
  interrupts = <0 207 4>;
  clocks = <&cru 348>, <&cru 349>, <&usb2phy>;
  clock-names = "usbhost", "arbiter", "utmi";
