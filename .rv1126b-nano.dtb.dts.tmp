 rtc: rtc@21280000 {
  compatible = "rockchip,rv1126b-rtc";
  reg = <0x21280000 0x1000>;
  rockchip,grf = <&grf>;
  interrupts = <0 215 4>;
  clocks = <&cru 350>;
  clock-names = "pclk_phy";
