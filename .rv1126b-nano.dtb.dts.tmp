# 1 "arch/arm64/boot/dts/rockchip/rv1126b-nano-gmac-rtl8211f.dtsi" 1





&gmac {

 phy-mode = "rgmii-rxid";
 clock_in_out = "output";

 snps,reset-gpio = <&gpio6 14 1>;
 snps,reset-active-low;

 snps,reset-delays-us = <0 20000 100000>;

 assigned-clocks = <&cru 114>;
 assigned-clock-rates = <25000000>;

 pinctrl-names = "default";
 pinctrl-0 = <&ethm0_miim_pins
       &ethm0_tx_bus2_pins
       &ethm0_rx_bus2_pins
       &ethm0_rgmii_clk_pins
       &ethm0_rgmii_bus_pins
       &phy_rst_pin>;

 tx_delay = <0x30>;


 phy-handle = <&rgmii_phy>;
 status = "okay";
};

&mdio {
 rgmii_phy: phy@1 {
  compatible = "ethernet-phy-ieee802.3-c22";
  reg = <0x1>;

  rtl821x,clkout-disable;

  rtl821x,led-link = <2>;

  rtl821x,led-act = <1>;
 };
};

&pinctrl {
 gmac {
  /omit-if-no-ref/
  phy_rst_pin: phy-rst-pin {
   rockchip,pins = <6 14 0 &pcfg_pull_up>;
  };
 };
};
