&pwm1_4ch_1 {
 status = "disabled";
 pinctrl-names = "active";
 pinctrl-0 = <&pwm1m1_ch0_pins>;
};

&spi0 {
 status = "disabled";
 max-freq = <20000000>;
 pinctrl-names = "default";
 pinctrl-0 = <&spi0m2_clk_pins &spi0m2_csn0_pins &spi0m2_csn1_pins>;

 spi-dev@0 {
  compatible = "rockchip,spidev";
  reg = <0x0>;
  spi-max-frequency = <50000000>;
  spi-lsb-first;
 };

 spi-dev@1 {
  compatible = "rockchip,spidev";
  reg = <0x1>;
  spi-max-frequency = <50000000>;
  spi-lsb-first;
 };
};

&spi1 {
 status = "disabled";
 max-freq = <20000000>;
