 pinctrl-0 = <&spi1m1_clk_pins &spi1m1_csn0_pins &spi1m1_csn1_pins>;

 spi-dev@0 {
  compatible = "rockchip,spidev";
  reg = <0x0>;
  spi-max-frequency = <50000000>;
  spi-lsb-first;
 };

 spi-dev@1 {
  compatible = "rockchip,spidev";
  reg = <0x1>;
  spi-max-frequency = <50000000>;
  spi-lsb-first;
 };
};

&i2c5 {
 pinctrl-0 = <&i2c5m0_pins>;
 status = "okay";
};

&uart4 {
