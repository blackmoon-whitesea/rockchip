  clocks = <&cru 170>, <&cru 169>,
    <&cru 171>, <&cru 172>;
  clock-names = "aclk_cif", "hclk_cif",
         "dclk_cif", "isp0clk_cif";
  resets = <&cru 0x001C0022>, <&cru 0x001C0021>,
    <&cru 0x001C0023>, <&cru 0x001C0024>;
  reset-names = "rst_cif_a", "rst_cif_h",
         "rst_cif_d", "rst_cif_isp0";
  rockchip,grf = <&ioc_grf>;
  iommus = <&rkcif_mmu>;
  status = "disabled";
 };

 rkcif_mmu: iommu@21d10f00 {
